# Copy to .env.worker.local. Never commit that local file.
# Dedicated Neon TEST branch only; never production.
BOSS_WORKER_MODE=termux-test
BOSS_TEST_DATABASE=YES
DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@YOUR-TEST-BRANCH-HOST/neondb?sslmode=require
DATABASE_SSL=require
BOTS_ENCRYPTION_KEY=REPLACE_WITH_THE_64_CHARACTER_HEX_KEY_FOR_TEST_BOT_DATA
QUEUE_POLL_INTERVAL_MS=1500
QUEUE_LEASE_SECONDS=120
WORKER_DB_POOL_MAX=2
BOSS_TEST_DATABASE_HOST=YOUR-TEST-BRANCH-HOST
BOSS_TEST_DATABASE_NAME=neondb
