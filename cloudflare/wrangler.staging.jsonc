{
  "name": "boss-bot-platform-ingress-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "PLATFORM_BOT_WEBHOOK_MODE": "disabled"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_VERIFIED_STAGING_HYPERDRIVE_ID"
    }
  ]
}
